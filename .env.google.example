# Google OAuth (Desktop / installed app) for Gmail potions-prompt agent.
# Copy to .env.google (gitignored) and fill in. Never commit real secrets.
#
# Create OAuth client: Google Cloud Console → APIs & Services → Credentials
# → Create OAuth client ID → Desktop app. Enable Gmail API on the project.
# Redirect URI: http://localhost

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_REDIRECT_URI=http://localhost

# Mailbox that receives prompts / sends replies
GMAIL_USER=you@gmail.com

# Only act on unread messages whose subject equals this (exact, case-sensitive)
GMAIL_PROMPT_SUBJECT=potions-prompt

# Poll interval for daemon mode (seconds)
GMAIL_POLL_SECONDS=90

# Where to store the OAuth token after `python -m live.gmail_prompt_agent auth`
GMAIL_TOKEN_PATH=.gmail_token.json

# Cursor CLI agent (optional; falls back to error reply if agent unavailable)
# CURSOR_API_KEY is usually in .env.cursor
AGENT_BIN=agent
AGENT_MODEL=
AGENT_TIMEOUT_SEC=3600

# Reply channel for agent results: gmail (default, threaded API) | resend
GMAIL_REPLY_VIA=gmail

# NOTE: NO_PROXY does NOT fix Cursor CLI TLS on this host — there is no
# HTTP(S)_PROXY. Zscaler/Thales inspects TLS transparently, so Cursor API
# hosts still present a Thales-issued MITM cert. Fix = install root
# "Thales Devices CA V4". Agent replies use Gmail API (HTTPS) by default.
